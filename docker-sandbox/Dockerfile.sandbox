FROM python:3.11-slim

# حذف المكتبات الخطرة
RUN rm -rf /usr/local/lib/python3.11/subprocess.py 2>/dev/null || true
RUN rm -rf /usr/local/lib/python3.11/os.py 2>/dev/null || true

WORKDIR /sandbox

# لا شبكة، ذاكرة محدودة، نظام ملفات للقراءة فقط
CMD ["python", "-c", "import sys; exec(sys.stdin.read())"]
